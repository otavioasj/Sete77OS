---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProcessStep from "../components/ProcessStep.astro";
import CTASection from "../components/CTASection.astro";

const pillars = [
  {
    name: "Presença",
    promise: "Seja encontrado e escolhido.",
    items: ["Sites institucionais premium", "Landing pages", "SEO local", "Google Business Profile"],
    href: "/servicos/presenca-digital",
    cta: "Ver Presença →",
  },
  {
    name: "Automação",
    promise: "Elimine o trabalho repetitivo.",
    items: ["Automações", "IA para atendimento", "Chatbots", "Agendamentos"],
    href: "/servicos/automacao",
    cta: "Ver Automação →",
  },
  {
    name: "Inteligência",
    promise: "Decida com dados, não com achismo.",
    items: ["CRM", "Dashboards", "Integrações"],
    href: "/servicos/inteligencia",
    cta: "Ver Inteligência →",
  },
  {
    name: "Engenharia",
    promise: "Construa a infraestrutura que sua operação merece.",
    items: ["Sistemas internos", "Portais", "Aplicações web", "Consultoria tecnológica"],
    href: "/servicos/engenharia",
    cta: "Ver Engenharia →",
  },
];
---

<BaseLayout
  title="Tecnologia para empresas crescerem"
  description="A Synapse implementa a tecnologia que faz sua empresa vender mais, atender melhor e perder menos clientes."
>
  <section class="hero-block">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
      <span class="hero-eyebrow">Tecnologia para empresas que querem crescer</span>
      <h1 class="hero-title">
        Sua empresa está <span class="text-gradient">perdendo clientes</span> — e
        provavelmente nem sabe disso.
      </h1>
      <p class="hero-lede">
        Enquanto você responde WhatsApp, tenta lembrar quem já foi contatado e torce
        para o cliente voltar sozinho, seus concorrentes já automatizaram isso. A
        Synapse implementa a tecnologia que fecha essa diferença.
      </p>
      <div class="hero-actions">
        <Button href="/contato" variant="glass">Descubra onde você está perdendo clientes</Button>
        <Button href="#como-funciona" variant="text" class="hero-secondary">Como funciona →</Button>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="diagnostico">
    <div class="container">
      <SectionHeading title="Três formas de perder dinheiro sem perceber" />
      <div class="grid cols-3">
        <div>
          <h3 class="problem-title">Invisibilidade digital</h3>
          <p class="problem-body">
            Se o seu cliente não te encontra no Google antes de te encontrar na rua,
            ele já escolheu o concorrente. Presença digital fraca não é detalhe — é
            receita que já foi embora antes de você saber que existia.
          </p>
        </div>
        <div>
          <h3 class="problem-title">Fadiga operacional</h3>
          <p class="problem-body">
            Toda hora que você passa respondendo mensagem, remarcando horário ou
            explicando a mesma coisa pela décima vez é uma hora que não foi para o
            que faz o seu negócio crescer.
          </p>
        </div>
        <div>
          <h3 class="problem-title">Vazamento de receita</h3>
          <p class="problem-body">
            Cliente satisfeito que não volta. Lead que esfria por falta de retorno.
            Avaliação ruim que ninguém respondeu. Cada um desses é dinheiro que você
            já gastou para conquistar — e perdeu por falta de estrutura.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="como-funciona">
    <div class="container">
      <SectionHeading title="Tecnologia não é o produto. É como resolvemos o seu problema." />
      <p class="body-text">
        A Synapse entra no seu negócio, entende onde você está perdendo tempo,
        clientes ou receita, e implementa exatamente a tecnologia certa para
        resolver isso — nem mais, nem menos. Sem prometer uma "transformação
        digital completa" que nunca sai do papel. Um problema de cada vez,
        resolvido de verdade.
      </p>
      <div class="grid cols-3 not-us">
        <p>Não somos agência de marketing.</p>
        <p>Não somos só desenvolvedores de site.</p>
        <p>Somos quem implementa a tecnologia certa para o seu negócio crescer.</p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading title="O que muda quando a tecnologia certa entra em ação" />
      <div class="disclosure">
        A Synapse é uma operação nova. Os pontos abaixo descrevem o resultado que
        buscamos entregar com base em cada tecnologia implementada — não são cases
        reais ainda. Assim que tivermos clientes, esta seção vira resultados de
        verdade.
      </div>
      <div class="grid cols-3">
        <p class="result-item">Menos horas presas em atendimento manual — com automação e IA de atendimento assumindo o repetitivo.</p>
        <p class="result-item">Mais visitantes virando cliente — com um site e uma presença local feitos para converter, não só para existir.</p>
        <p class="result-item">Menos clientes perdidos por falta de retorno — com CRM e acompanhamento automático de relacionamento.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        title="Onde a Synapse implementa tecnologia"
        subtitle="Agrupados pelo problema que resolvem — não pela ferramenta por trás."
      />
      <div class="grid cols-4">
        {pillars.map((pillar) => <ServiceCard {...pillar} />)}
      </div>
      <div class="section-cta">
        <Button href="/servicos" variant="text">Ver todos os serviços →</Button>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading title="Como trabalhamos" />
      <div class="steps">
        <ProcessStep number="01" title="Diagnóstico">
          Mapeamos onde você está perdendo tempo, clientes ou receita. Sem
          diagnóstico, não existe implementação — só achismo.
        </ProcessStep>
        <ProcessStep number="02" title="Fundação">
          Colocamos sua presença digital no lugar certo: site, SEO local, Google
          Business Profile. A base que faz o cliente te encontrar e confiar em
          você.
        </ProcessStep>
        <ProcessStep number="03" title="Automação">
          Eliminamos o trabalho repetitivo com atendimento e agendamento
          automatizados, liberando o seu tempo para o que só você pode fazer.
        </ProcessStep>
        <ProcessStep number="04" title="Crescimento contínuo">
          CRM, dashboards e otimização constante. A tecnologia evolui junto com
          o seu negócio — a relação não termina na entrega.
        </ProcessStep>
      </div>
      <div class="section-cta">
        <Button href="/processo" variant="text">Ver o processo completo →</Button>
      </div>
    </div>
  </section>

  <CTASection
    dark
    title="Pronto para parar de perder clientes para quem só tem mais tecnologia — não mais valor?"
    body="Conte o que está acontecendo no seu negócio hoje. A Synapse volta com um diagnóstico do que está custando clientes, tempo ou receita — e o que fazer a respeito."
    ctaLabel="Fale com a Synapse"
  />
</BaseLayout>

<style>
  .hero-block {
    position: relative;
    overflow: hidden;
    margin-inline: var(--space-3);
    border-radius: var(--radius-block);
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
  }

  @media (min-width: 1024px) {
    .hero-block {
      margin-inline: var(--space-4);
    }
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 22% 0%, rgba(0, 201, 255, 0.28), transparent 65%),
      radial-gradient(55% 50% at 85% 15%, rgba(124, 58, 237, 0.25), transparent 65%),
      radial-gradient(120% 90% at 50% -10%, transparent 30%, rgba(13, 27, 42, 0.6) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin-inline: auto;
    padding: var(--space-12) var(--space-4) var(--space-12);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-inner {
      padding-block: var(--space-16);
    }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    padding: 6px var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-extrabold);
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .hero-lede {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.65);
    max-width: 60ch;
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    justify-content: center;
  }

  .hero-actions :global(.hero-secondary) {
    color: rgba(255, 255, 255, 0.8);
  }

  .hero-actions :global(.hero-secondary:hover) {
    color: var(--color-text-on-dark);
  }

  .problem-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .problem-body,
  .body-text {
    color: var(--color-text-secondary);
  }

  .body-text {
    max-width: 70ch;
    margin-bottom: var(--space-6);
  }

  .not-us p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding: var(--space-3);
    border-left: 2px solid var(--color-border);
  }

  .not-us p:last-child {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    border-left-color: var(--color-accent);
  }

  .result-item {
    color: var(--color-text-secondary);
  }

  .steps {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-border);
  }

  .section-cta {
    margin-top: var(--space-6);
  }
</style>
